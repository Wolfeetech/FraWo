{
  "uid": "frawo-lage",
  "title": "FraWo — Lage",
  "description": "Ein Blick: was laeuft, wie stark ausgelastet, seit wann. Ersetzt Ueberblick/System-Overview/Infrastructure/Server-Maschinen.",
  "tags": ["frawo", "lage"],
  "timezone": "Europe/Berlin",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "type": "row",
      "title": "Lage auf einen Blick",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Dienste erreichbar",
      "description": "Wie viele der ueberwachten Web-, DNS- und Streamdienste gerade antworten.",
      "datasource": { "type": "prometheus", "uid": "cfqrxzeq29fcwb" },
      "gridPos": { "h": 5, "w": 5, "x": 0, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "sum(probe_success)", "legendFormat": "erreichbar", "instant": true },
        { "refId": "B", "expr": "count(probe_success)", "legendFormat": "gesamt", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 15 },
              { "color": "green", "value": 19 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } }]
          }
        ]
      }
    },
    {
      "type": "stat",
      "title": "Rechner online",
      "description": "Physische Rechner und der Ueberwachungs-Container, die Systemdaten liefern.",
      "datasource": { "type": "prometheus", "uid": "cfqrxzeq29fcwb" },
      "gridPos": { "h": 5, "w": 5, "x": 5, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "count(up{job=~\"node_exporter|windows_studiopc\"} == 1)", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 4 },
              { "color": "green", "value": 5 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Gaeste laufend",
      "description": "Container und virtuelle Maschinen auf allen Proxmox-Knoten.",
      "datasource": { "type": "prometheus", "uid": "cfqrxzeq29fcwb" },
      "gridPos": { "h": 5, "w": 5, "x": 10, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "sum(pve_up)", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 10 },
              { "color": "green", "value": 14 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Offene Alarme",
      "description": "Alarme im Zustand 'feuert'. Null ist der Normalzustand.",
      "datasource": { "type": "prometheus", "uid": "cfqrxzeq29fcwb" },
      "gridPos": { "h": 5, "w": 9, "x": 15, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "count(ALERTS{alertstate=\"firing\", severity=\"critical\"}) or vector(0)", "legendFormat": "kritisch", "instant": true },
        { "refId": "B", "expr": "count(ALERTS{alertstate=\"firing\", severity=\"warning\"}) or vector(0)", "legendFormat": "Warnung", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name",
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "type": "row",
      "title": "Auslastung jetzt",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "collapsed": false
    },
    {
      "type": "gauge",
      "title": "Rechenlast",
      "description": "Anteil der Rechenzeit, der gerade gebraucht wird. Dauerhaft ueber 85 % heisst: der Rechner kommt nicht hinterher.",
      "datasource": { "type": "prometheus", "uid": "cfqrxzeq29fcwb" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg by(instance)(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "{{instance}}",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "100 - (avg by(instance)(rate(windows_cpu_time_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "{{instance}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "minVizWidth": 75,
        "minVizHeight": 75,
        "sizing": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 70 },
              { "color": "orange", "value": 85 },
              { "color": "red", "value": 95 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "gauge",
      "title": "Arbeitsspeicher belegt",
      "description": "Wie voll der Arbeitsspeicher ist. Ueber 90 % wird es eng - dann verdraengt der Rechner Dinge auf die Platte und wird langsam.",
      "datasource": { "type": "prometheus", "uid": "cfqrxzeq29fcwb" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100",
          "legendFormat": "{{instance}}",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "(1 - windows_os_physical_memory_free_bytes / windows_cs_physical_memory_bytes) * 100",
          "legendFormat": "{{instance}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "minVizWidth": 75,
        "minVizHeight": 75,
        "sizing": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 75 },
              { "color": "orange", "value": 90 },
              { "color": "red", "value": 96 }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "type": "row",
      "title": "Laufzeit und Platten",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false
    },
    {
      "type": "bargauge",
      "title": "Laeuft ununterbrochen seit",
      "description": "Zeit seit dem letzten Neustart. Ein unerwarteter Sprung auf wenige Minuten bedeutet: der Rechner war weg.",
      "datasource": { "type": "prometheus", "uid": "cfqrxzeq29fcwb" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 15 },
      "targets": [
        {
          "refId": "A",
          "expr": "node_time_seconds - node_boot_time_seconds",
          "legendFormat": "{{instance}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "minVizWidth": 8,
        "minVizHeight": 16,
        "sizing": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "max": 2592000,
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "orange", "value": null },
              { "color": "#EAB839", "value": 3600 },
              { "color": "green", "value": 86400 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "bargauge",
      "title": "Systemplatte belegt",
      "description": "Belegung der Wurzel-Partition. Laeuft sie voll, bleibt der ganze Rechner stehen.",
      "datasource": { "type": "prometheus", "uid": "cfqrxzeq29fcwb" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 15 },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - node_filesystem_avail_bytes{mountpoint=\"/\", fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\", fstype!~\"tmpfs|overlay\"}) * 100",
          "legendFormat": "{{instance}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "minVizWidth": 8,
        "minVizHeight": 16,
        "sizing": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 75 },
              { "color": "orange", "value": 85 },
              { "color": "red", "value": 92 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "bargauge",
      "title": "Wartende Arbeit (Last, 5 Min)",
      "description": "Wie viele Aufgaben im Schnitt auf Bearbeitung warten. Faustregel: dauerhaft hoeher als die Anzahl Rechenkerne ist zu viel.",
      "datasource": { "type": "prometheus", "uid": "cfqrxzeq29fcwb" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 15 },
      "targets": [
        {
          "refId": "A",
          "expr": "node_load5",
          "legendFormat": "{{instance}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "minVizWidth": 8,
        "minVizHeight": 16,
        "sizing": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 16,
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 6 },
              { "color": "orange", "value": 10 },
              { "color": "red", "value": 16 }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "type": "row",
      "title": "Verlauf",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Rechenlast im Verlauf",
      "description": "Entwicklung der Auslastung. Hier sieht man, ob eine Spitze einmalig war oder ein Dauerzustand.",
      "datasource": { "type": "prometheus", "uid": "cfqrxzeq29fcwb" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg by(instance)(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "{{instance}}"
        },
        {
          "refId": "B",
          "expr": "100 - (avg by(instance)(rate(windows_cpu_time_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "{{instance}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "Auslastung %",
            "gradientMode": "none"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Arbeitsspeicher im Verlauf",
      "description": "Steigt die Linie stetig ohne zurueckzufallen, haelt ein Dienst Speicher fest.",
      "datasource": { "type": "prometheus", "uid": "cfqrxzeq29fcwb" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100",
          "legendFormat": "{{instance}}"
        },
        {
          "refId": "B",
          "expr": "(1 - windows_os_physical_memory_free_bytes / windows_cs_physical_memory_bytes) * 100",
          "legendFormat": "{{instance}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "belegt %",
            "gradientMode": "none"
          }
        },
        "overrides": []
      }
    },

    {
      "type": "row",
      "title": "Dienste im Einzelnen",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "collapsed": false
    },
    {
      "type": "table",
      "title": "Alle ueberwachten Dienste",
      "description": "Jeder geprueffte Dienst mit Zustand und Antwortzeit. Sortiert: Probleme zuerst.",
      "datasource": { "type": "prometheus", "uid": "cfqrxzeq29fcwb" },
      "gridPos": { "h": 12, "w": 14, "x": 0, "y": 32 },
      "targets": [
        { "refId": "A", "expr": "probe_success", "format": "table", "instant": true },
        { "refId": "B", "expr": "probe_duration_seconds", "format": "table", "instant": true }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "instance", "mode": "outer" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true, "Time 1": true, "Time 2": true,
              "__name__": true, "__name__ 1": true, "__name__ 2": true,
              "job 2": true, "module 2": true
            },
            "renameByName": {
              "instance": "Dienst",
              "job": "Art",
              "job 1": "Art",
              "module": "Pruefung",
              "module 1": "Pruefung",
              "Value #A": "Zustand",
              "Value #B": "Antwortzeit"
            }
          }
        },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "Zustand", "desc": false }] } }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false, "reducer": ["sum"], "countRows": false, "fields": "" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Zustand" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } },
              { "id": "mappings", "value": [
                { "type": "value", "options": { "0": { "text": "AUSGEFALLEN", "color": "red", "index": 0 }, "1": { "text": "laeuft", "color": "green", "index": 1 } } }
              ]},
              { "id": "custom.width", "value": 130 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Antwortzeit" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "decimals", "value": 2 },
              { "id": "custom.width", "value": 110 }
            ]
          }
        ]
      }
    },
    {
      "type": "table",
      "title": "Container und virtuelle Maschinen",
      "description": "Jeder Gast auf jedem Proxmox-Knoten. 'ausgeschaltet' ist nicht immer ein Fehler - aber es sollte gewollt sein.",
      "datasource": { "type": "prometheus", "uid": "cfqrxzeq29fcwb" },
      "gridPos": { "h": 12, "w": 10, "x": 14, "y": 32 },
      "targets": [
        { "refId": "A", "expr": "pve_up", "format": "table", "instant": true }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true, "type": true },
            "renameByName": { "id": "Gast", "node": "laeuft auf", "name": "Name", "Value": "Zustand" }
          }
        },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "Zustand", "desc": false }] } }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false, "reducer": ["sum"], "countRows": false, "fields": "" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Zustand" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } },
              { "id": "mappings", "value": [
                { "type": "value", "options": { "0": { "text": "ausgeschaltet", "color": "orange", "index": 0 }, "1": { "text": "laeuft", "color": "green", "index": 1 } } }
              ]},
              { "id": "custom.width", "value": 130 }
            ]
          }
        ]
      }
    }
  ],
  "schemaVersion": 39,
  "version": 1,
  "weekStart": "monday"
}

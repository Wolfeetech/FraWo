{
  "id": 5,
  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "{{instance}}"
        }
      ],
      "title": "CPU per Node",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
          "legendFormat": "{{instance}} used"
        },
        {
          "datasource": "Prometheus",
          "expr": "node_memory_MemTotal_bytes",
          "legendFormat": "{{instance}} total"
        }
      ],
      "title": "Memory Usage per Node",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "id": 3,
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "node_filesystem_size_bytes{fstype!=\"tmpfs\",mountpoint=\"/\"}",
          "instant": true,
          "legendFormat": "{{instance}} total"
        },
        {
          "datasource": "Prometheus",
          "expr": "node_filesystem_avail_bytes{fstype!=\"tmpfs\",mountpoint=\"/\"}",
          "instant": true,
          "legendFormat": "{{instance}} free"
        }
      ],
      "title": "Disk Space per Node",
      "type": "table"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "id": 4,
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "node_time_seconds - node_boot_time_seconds",
          "legendFormat": "{{instance}}"
        }
      ],
      "title": "Node Uptime",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 12
      },
      "id": 5,
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "count(up{job=\"node_exporter\"})"
        }
      ],
      "title": "Hosts Monitored",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 12
      },
      "id": 6,
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "count(up{job=\"blackbox_http\"})"
        }
      ],
      "title": "Services Monitored",
      "type": "stat"
    }
  ],
  "refresh": "1m",
  "tags": [
    "frawo",
    "infra"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "FraWo — Infrastructure",
  "uid": "frawo-infrastructure",
  "version": 1
}
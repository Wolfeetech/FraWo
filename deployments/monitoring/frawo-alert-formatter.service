[Unit]
Description=FraWo Alert Formatter (Ollama + Deterministischer 4-Zeilen-Fallback)
After=network.target prometheus-alertmanager.service
Wants=prometheus-alertmanager.service

[Service]
Type=simple
User=root
EnvironmentFile=-/etc/frawo/alert-formatter.env
ExecStart=/usr/bin/python3 /usr/local/bin/frawo_alert_formatter.py
Restart=always
RestartSec=3
KillMode=process

[Install]
WantedBy=multi-user.target

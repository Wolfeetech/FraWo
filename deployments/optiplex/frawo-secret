#!/usr/bin/env bash
# frawo-secret – Agenten-Zugriff auf die freigegebene Vaultwarden-Sammlung (Odoo #1931).
# Wolf 06.10.: vorhandene Sammlung "FraWo" verwenden. Genutzt wird die EINE Sammlung, die das
# Agenten-Konto sehen darf; sieht es mehrere, entscheidet SAMMLUNG in /etc/frawo/bw.conf.
# Laeuft auf dem OptiPlex-Host. Konto agent@frawo.tech; Master-Passwort in /etc/frawo/bw-master (0600).
#
#   frawo-secret ablegen "Nextcloud cloud.frawo.tech - wolf" [benutzer] [url] < wertdatei
#   frawo-secret holen   "Nextcloud cloud.frawo.tech - wolf" | befehl-der-es-braucht
#   frawo-secret liste                       # nur Namen, nie Werte
#
# Regeln: Werte gehen nur per stdin hinein und per Pipe hinaus, nie als Argument (ps/History),
# nie auf ein Terminal. "holen" verweigert die Ausgabe, wenn stdout ein Terminal ist.
set -euo pipefail
export BITWARDENCLI_APPDATA_DIR=/root/.config/frawo-bw
KONTO=agent@frawo.tech
PWDATEI=/etc/frawo/bw-master
SAMMLUNG=""
[ -r /etc/frawo/bw.conf ] && . /etc/frawo/bw.conf
[ -r "$PWDATEI" ] || { echo "FEHLER: $PWDATEI fehlt (Agenten-Konto noch nicht eingerichtet)" >&2; exit 1; }

sitzung() {
  local st; st=$(bw status 2>/dev/null | python3 -c 'import sys,json; print(json.load(sys.stdin)["status"])')
  if [ "$st" = "unauthenticated" ]; then bw login "$KONTO" --passwordfile "$PWDATEI" --raw >/dev/null; fi
  bw unlock --passwordfile "$PWDATEI" --raw
}
BW_SESSION=$(sitzung); export BW_SESSION
bw sync >/dev/null

ids() {  # organisationId und sammlungsId der freigegebenen Sammlung
  bw list collections | python3 -c "
import sys,json
alle=json.load(sys.stdin); wunsch=sys.argv[1]
c=[x for x in alle if x['name']==wunsch] if wunsch else alle
assert len(c)==1, 'Sammlung nicht eindeutig: sichtbar sind %s' % [x['name'] for x in alle]
print(c[0]['organizationId'], c[0]['id'])" "$SAMMLUNG"
}

case "${1:-}" in
  liste)
    read -r ORG COL < <(ids)
    bw list items --collectionid "$COL" | python3 -c 'import sys,json; [print(x["name"]) for x in json.load(sys.stdin)]'
    ;;
  holen)
    [ -t 1 ] && { echo "FEHLER: Ausgabe nur in eine Pipe, nicht aufs Terminal" >&2; exit 1; }
    read -r ORG COL < <(ids)
    bw list items --collectionid "$COL" --search "$2" | python3 -c "
import sys,json
t=[x for x in json.load(sys.stdin) if x['name']==sys.argv[1]]
assert len(t)==1, 'Eintrag nicht eindeutig gefunden'
sys.stdout.write((t[0].get('login') or {}).get('password') or '')" "$2"
    ;;
  ablegen)
    NAME=${2:?Name fehlt}; BENUTZER=${3:-}; URL=${4:-}
    WERT=$(cat); [ -n "$WERT" ] || { echo "FEHLER: kein Wert auf stdin" >&2; exit 1; }
    read -r ORG COL < <(ids)
    VORHANDEN=$(bw list items --collectionid "$COL" --search "$NAME" | python3 -c "
import sys,json; t=[x['id'] for x in json.load(sys.stdin) if x['name']==sys.argv[1]]; print(t[0] if t else '')" "$NAME")
    JSON=$(WERT="$WERT" python3 -c "
import os,json,sys
name,benutzer,url,org,col=sys.argv[1:6]
print(json.dumps({'type':1,'name':name,'organizationId':org,'collectionIds':[col],
  'notes':'Abgelegt von Claude (frawo-secret)',
  'login':{'username':benutzer or None,'password':os.environ['WERT'],'uris':[{'uri':url}] if url else []}}))" \
      "$NAME" "$BENUTZER" "$URL" "$ORG" "$COL")
    unset WERT
    if [ -n "$VORHANDEN" ]; then
      printf '%s' "$JSON" | bw encode | bw edit item "$VORHANDEN" >/dev/null && echo "aktualisiert: $NAME"
    else
      printf '%s' "$JSON" | bw encode | bw create item >/dev/null && echo "abgelegt: $NAME"
    fi
    ;;
  *) echo "Nutzung: frawo-secret liste | holen <name> | ablegen <name> [benutzer] [url] < wert" >&2; exit 2;;
esac

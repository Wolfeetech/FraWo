[Unit]
Description=Rclone Mount for Google Drive (5TB) - FraWo 2.0
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/bin/mkdir -p /var/cache/rclone
ExecStart=/usr/bin/rclone mount gdrive: /mnt/google-drive \
    --cache-dir /var/cache/rclone \
    --vfs-cache-mode full \
    --vfs-cache-max-age 24h \
    --vfs-cache-max-size 25G \
    --allow-other --allow-non-empty \
    --buffer-size 32M \
    --tpslimit 8 \
    --tpslimit-burst 10 \
    --drive-chunk-size 64M \
    --log-level INFO
ExecStop=/bin/fusermount -u /mnt/google-drive
Restart=always
RestartSec=15
TimeoutStopSec=30
KillMode=mixed

[Install]
WantedBy=multi-user.target
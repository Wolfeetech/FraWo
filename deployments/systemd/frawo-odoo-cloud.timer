[Unit]
Description=Taeglicher Lauf der verschluesselten Odoo-Cloud-Kopie

[Timer]
# 07:35 — CT140 schreibt seinen Datenbankabzug um 03:30 UTC (05:30 CEST).
# Der taegliche Proxmox-vzdump-Auftrag (daily-all-pbs) laeuft von 04:00 bis ca. 07:25 CEST
# und lastet den Google-Drive-Upstream voll aus.
# Lauf um 07:35 CEST gewaehrleistet freie Bandbreite nach Abschluss der vzdumps
# und liegt 25 Minuten vor dem Backup-TÜV um 08:00 CEST.
OnCalendar=*-*-* 07:35:00
# Nach einem Neustart nachholen statt einen Tag auslassen.
Persistent=true
RandomizedDelaySec=180

[Install]
WantedBy=timers.target

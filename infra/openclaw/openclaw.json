{
  "gateway": { "mode": "local", "port": 19000 },
  "plugins": {
    "entries": {
      "openai": {
        "baseURL": "https://models.inference.ai.azure.com"
      },
      "anthropic": {}
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openai/gpt-4o-mini",
        "fallbacks": ["openai/gpt-4o"]
      }
    }
  },
  "channels": {
    "telegram": { "enabled": true, "dmPolicy": "pairing" }
  }
}

    "key": "website.footer_custom",
    "name": "Default",
    "arch_db": "<data inherit_id=\"website.layout\" name=\"Default\" active=\"True\">\n    <xpath expr=\"//div[@id='footer']\" position=\"replace\">\n        <div id=\"footer\" class=\"oe_structure oe_structure_solo\" t-ignore=\"true\" t-if=\"not no_footer\">\n<style>\n  #footer {\n    background: #0a0a0a !important;\n    border-top: 1px solid rgba(255,255,255,0.08) !important;\n    padding: 60px 0 90px !important; /* extra bottom padding for sticky radio bar */\n  }\n  #footer h5 {\n    color: #ffffff !important;\n    font-size: 0.8rem !important;\n    font-weight: 700 !important;\n    text-transform: uppercase !important;\n    letter-spacing: 0.12em !important;\n    margin-bottom: 20px !important;\n    font-family: monospace !important;\n  }\n  #footer a {\n    color: #94a3b8 !important;\n    text-transform: uppercase;\n    font-size: 0.75rem;\n    font-weight: 500;\n    letter-spacing: 0.08em;\n    text-decoration: none;\n    transition: color 0.2s;\n  }\n  #footer a:hover {\n    color: #ffffff !important;\n  }\n  #footer p {\n    color: #94a3b8 !important;\n    font-size: 0.9rem;\n    line-height: 1.6;\n  }\n\n  /* Sticky Radio Player Bar */\n  .fw-radio-bar {\n    position: fixed;\n    bottom: 0;\n    left: 0;\n    right: 0;\n    height: 56px;\n    background: rgba(10, 15, 13, 0.95);\n    backdrop-filter: blur(12px);\n    -webkit-backdrop-filter: blur(12px);\n    border-top: 1.5px solid #004030;\n    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.5);\n    z-index: 9999;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: 0 24px;\n    font-family: 'Inter', -apple-system, sans-serif;\n    color: #ffffff;\n  }\n  .fw-radio-left {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    min-width: 240px;\n  }\n  .fw-live-badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    background: rgba(0, 64, 48, 0.8);\n    border: 1px solid #2ecc71;\n    padding: 3px 8px;\n    border-radius: 4px;\n    font-size: 0.7rem;\n    font-weight: 700;\n    letter-spacing: 0.05em;\n    color: #2ecc71;\n  }\n  .fw-live-dot {\n    width: 6px;\n    height: 6px;\n    background: #2ecc71;\n    border-radius: 50%;\n    animation: fwPulse 2s infinite;\n  }\n  @keyframes fwPulse {\n    0%, 100% { opacity: 1; transform: scale(1); }\n    50% { opacity: 0.4; transform: scale(1.2); }\n  }\n  .fw-radio-meta {\n    display: flex;\n    flex-direction: column;\n    overflow: hidden;\n  }\n  .fw-radio-station {\n    font-size: 0.8rem;\n    font-weight: 700;\n    color: #ffffff;\n    letter-spacing: 0.02em;\n  }\n  .fw-radio-track {\n    font-size: 0.72rem;\n    color: #94a3b8;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    max-width: 280px;\n  }\n\n  .fw-radio-center {\n    display: flex;\n    align-items: center;\n    gap: 16px;\n  }\n  .fw-play-btn {\n    width: 38px;\n    height: 38px;\n    border-radius: 50%;\n    background: #004030;\n    border: 1px solid #2ecc71;\n    color: #ffffff;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    cursor: pointer;\n    transition: all 0.2s;\n  }\n  .fw-play-btn:hover {\n    background: #2ecc71;\n    color: #004030;\n    transform: scale(1.05);\n  }\n  .fw-play-btn svg {\n    width: 16px;\n    height: 16px;\n    fill: currentColor;\n  }\n\n  .fw-radio-right {\n    display: flex;\n    align-items: center;\n    gap: 16px;\n  }\n  .fw-volume-box {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n  }\n  .fw-vol-slider {\n    width: 80px;\n    height: 4px;\n    accent-color: #2ecc71;\n    cursor: pointer;\n  }\n  .fw-external-link {\n    font-size: 0.75rem;\n    color: #a050f0 !important;\n    font-weight: 600;\n    display: inline-flex;\n    align-items: center;\n    gap: 4px;\n  }\n  .fw-external-link:hover {\n    color: #ffffff !important;\n  }\n\n  @media (max-width: 768px) {\n    .fw-radio-right, .fw-radio-track { display: none !important; }\n    .fw-radio-bar { padding: 0 16px; }\n  }\n\n  .o_brand_promotion, .o_footer_copyright .o_brand_promotion, .o_footer_copyright small { display: none !important; visibility: hidden !important; height: 0 !important; margin: 0 !important; padding: 0 !important; }\n</style>\n\n            <section class=\"s_text_block pt40 pb16\" data-snippet=\"s_text_block\" data-name=\"Text\">\n                <div class=\"container\">\n                    <div class=\"row\">\n                        <div class=\"col-lg-2 pt24 pb24\">\n                            <h5 class=\"mb-3\">Navigation</h5>\n                            <ul class=\"list-unstyled\">\n                                <li><a href=\"/\">Home</a></li>\n                                <li><a href=\"/#services\">Leistungen</a></li>\n                                <li><a href=\"/verleih\">Mietpark</a></li>\n                                <li><a href=\"/referenzen\">Referenzen</a></li>\n                                <li><a href=\"/impressum\">Impressum</a></li>\n                                <li><a href=\"/datenschutz\">Datenschutz</a></li>\n                                <li><a href=\"/contactus\">Kontakt</a></li>\n                            </ul>\n                        </div>\n                        <div class=\"col-lg-5 pt24 pb24\">\n                            <h5 class=\"mb-3\">Über FraWo</h5>\n                            <p>FraWo GbR — Veranstaltungstechnik, Veranstaltungstechnik, FOH-Regie, Equipment-Mietpark und präziser Holz-Sonderbau aus Lindau.\n                            <br/><br/> Persönlich, lokal und zuverlässig — von der einzelnen Box bis zur kompletten Bühne.</p>\n                        </div>\n                        <div id=\"connect\" class=\"col-lg-4 offset-lg-1 pt24 pb24\">\n                            <h5 class=\"mb-3\">Kontakt</h5>\n                            <ul class=\"list-unstyled\">\n                                <li><i class=\"fa fa-comment fa-fw me-2\"/><span><a href=\"/contactus\">Kontaktieren</a></span></li>\n                                <li><i class=\"fa fa-envelope fa-fw me-2\"/><span><a href=\"mailto:kontakt@frawo.tech\">kontakt@frawo.tech</a></span></li>\n                                <li><i class=\"fa fa-phone fa-fw me-2\"/><span><a href=\"tel:+4915155243164\">Telefonisch anfragen</a></span></li>\n                                <li><i class=\"fa fa-whatsapp fa-fw me-2\"/><span><a href=\"https://wa.me/4915155243164\" target=\"_blank\">WhatsApp Chat</a></span></li>\n                            </ul>\n                        </div>\n                    </div>\n                </div>\n            </section>\n\n            <!-- Sticky FraWo Funk Player Bar -->\n            <div class=\"fw-radio-bar\">\n                <div class=\"fw-radio-left\">\n                    <div class=\"fw-live-badge\">\n                        <span class=\"fw-live-dot\"/> LIVE\n                    </div>\n                    <div class=\"fw-radio-meta\">\n                        <div class=\"fw-radio-station\">FraWo Funk Radio</div>\n                        <div class=\"fw-radio-track\" id=\"fw-radio-track-title\">Bodensee Dayparting Stream</div>\n                    </div>\n                </div>\n\n                <div class=\"fw-radio-center\">\n                    <button class=\"fw-play-btn\" id=\"fw-play-toggle\" onclick=\"toggleFraWoRadio()\" aria-label=\"FraWo Funk abspielen/pausieren\">\n                        <svg id=\"fw-icon-play\" viewBox=\"0 0 24 24\"><path d=\"M8 5v14l11-7z\"/></svg>\n                        <svg id=\"fw-icon-pause\" viewBox=\"0 0 24 24\" style=\"display:none;\"><path d=\"M6 4h4v16H6V4zm8 0h4v16h-4V4z\"/></svg>\n                    </button>\n                </div>\n\n                <div class=\"fw-radio-right\">\n                    <div class=\"fw-volume-box\">\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"#94a3b8\"><path d=\"M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z\"/></svg>\n                        <input type=\"range\" class=\"fw-vol-slider\" min=\"0\" max=\"100\" value=\"80\" oninput=\"setFraWoVolume(this.value)\" aria-label=\"Lautstärke\"/>\n                    </div>\n                    <a href=\"https://funk.frawo.tech/\" target=\"_blank\" class=\"fw-external-link\">Web Player ↗</a>\n                </div>\n            </div>\n\n            <audio id=\"frawo-live-stream\" preload=\"none\">\n                <source src=\"https://funk.frawo.tech/listen/frawo_funk/radio.mp3\" type=\"audio/mpeg\"/>\n            </audio>\n\n            <script>\n                var radioAudio = document.getElementById('frawo-live-stream');\n                var isRadioPlaying = false;\n\n                function toggleFraWoRadio() {\n                    if (!radioAudio) radioAudio = document.getElementById('frawo-live-stream');\n                    if (isRadioPlaying) {\n                        radioAudio.pause();\n                        isRadioPlaying = false;\n                        document.getElementById('fw-icon-play').style.display = 'block';\n                        document.getElementById('fw-icon-pause').style.display = 'none';\n                    } else {\n                        radioAudio.play().then(function() {\n                            isRadioPlaying = true;\n                            document.getElementById('fw-icon-play').style.display = 'none';\n                            document.getElementById('fw-icon-pause').style.display = 'block';\n                        }).catch(function(err) {\n                            console.error('Playback error:', err);\n                        });\n                    }\n                }\n\n                function setFraWoVolume(val) {\n                    if (radioAudio) radioAudio.volume = val / 100;\n                }\n\n                function updateNowPlaying() {\n                    fetch('https://funk.frawo.tech/api/nowplaying/frawo_funk')\n                        .then(function(res) { return res.json(); })\n                        .then(function(data) {\n                            if (data &amp;&amp; data.now_playing &amp;&amp; data.now_playing.song) {\n                                var s = data.now_playing.song;\n                                var t = (s.artist ? s.artist + ' – ' : '') + (s.title || 'Live Rotation');\n                                var elem = document.getElementById('fw-radio-track-title');\n                                if (elem) elem.textContent = t;\n                            }\n                        })\n                        .catch(function(e) { /* silent */ });\n                }\n\n                setInterval(updateNowPlaying, 20000);\n                setTimeout(updateNowPlaying, 2000);\n            </script>\n        </div>\n    </xpath>\n</data>",
    "lang": "de_DE"
  },

{
  "id": 1,
  "name": "FraWo GbR",
  "domain": "https://frawo.tech",
  "custom_code_footer": "\n<div id=\"fwPersistentPlayerBar\" class=\"fw-persistent-player\" style=\"display: none;\">\n  <div class=\"fw-player-inner\">\n    <div class=\"fw-player-left\">\n      <div class=\"fw-player-cover-box\">\n        <img id=\"fwBarCover\" src=\"/logo.png?company=1\" width=\"40\" height=\"40\" alt=\"Cover\" class=\"fw-bar-cover-img\"/>\n        <span class=\"fw-bar-pulse\"></span>\n      </div>\n      <div class=\"fw-player-meta\">\n        <div id=\"fwBarTitle\" class=\"fw-bar-title\">FraWo Funk Live</div>\n        <div id=\"fwBarArtist\" class=\"fw-bar-artist\">320kbps HD Broadcast</div>\n      </div>\n    </div>\n\n    <div class=\"fw-player-center\">\n      <button id=\"fwBarPlayBtn\" class=\"fw-bar-btn\" onclick=\"window.fwAudio.togglePlay()\" title=\"Play / Pause\">\n        ▶\n      </button>\n      <div class=\"fw-bar-eq\" id=\"fwBarEq\">\n        <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>\n      </div>\n    </div>\n\n    <div class=\"fw-player-right\">\n      <div class=\"fw-bar-badge\">● LIVE 320 KBPS</div>\n      <div class=\"fw-bar-vol-box\">\n        <span style=\"font-size: 0.8rem; color: #98a29e;\">🔊</span>\n        <input type=\"range\" min=\"0\" max=\"1\" step=\"0.05\" value=\"0.8\" id=\"fwBarVol\" oninput=\"window.fwAudio.setVolume(this.value)\" class=\"fw-bar-slider\"/>\n      </div>\n      <a href=\"/radio\" class=\"fw-bar-open-btn\">Radio-Zentrale &#8599;</a>\n    </div>\n  </div>\n</div>\n\n<style>\n  /* Persistent Bottom Audio Player Bar */\n  .fw-persistent-player {\n    position: fixed;\n    bottom: 0;\n    left: 0;\n    right: 0;\n    height: 64px;\n    background: rgba(12, 16, 14, 0.96);\n    backdrop-filter: blur(16px);\n    -webkit-backdrop-filter: blur(16px);\n    border-top: 1px solid #2a2e2c;\n    z-index: 99999;\n    box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.6);\n    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);\n  }\n\n  .fw-player-inner {\n    max-width: 1200px;\n    margin: 0 auto;\n    height: 100%;\n    padding: 0 20px;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    gap: 20px;\n  }\n\n  .fw-player-left {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    min-width: 220px;\n  }\n\n  .fw-player-cover-box {\n    width: 40px;\n    height: 40px;\n    background: #000;\n    border: 1px solid #2a2e2c;\n    position: relative;\n    overflow: hidden;\n    flex-shrink: 0;\n  }\n\n  .fw-bar-cover-img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n  }\n\n  .fw-bar-pulse {\n    position: absolute;\n    top: 3px;\n    right: 3px;\n    width: 6px;\n    height: 6px;\n    background: #2ecc71;\n    border-radius: 50%;\n  }\n\n  .fw-player-meta {\n    overflow: hidden;\n  }\n\n  .fw-bar-title {\n    font-size: 0.85rem;\n    font-weight: 700;\n    color: #ffffff;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    max-width: 200px;\n  }\n\n  .fw-bar-artist {\n    font-size: 0.75rem;\n    color: #98a29e;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    max-width: 200px;\n  }\n\n  .fw-player-center {\n    display: flex;\n    align-items: center;\n    gap: 16px;\n  }\n\n  .fw-bar-btn {\n    width: 42px;\n    height: 42px;\n    background: #a050f0;\n    color: #ffffff;\n    border: none;\n    font-size: 1.1rem;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    cursor: pointer;\n    border-radius: 0px;\n    transition: background 0.2s ease, transform 0.1s ease;\n  }\n\n  .fw-bar-btn:hover {\n    background: #9d4edd;\n    transform: scale(1.05);\n  }\n\n  .fw-bar-eq {\n    display: flex;\n    align-items: flex-end;\n    gap: 3px;\n    height: 20px;\n    padding: 2px 4px;\n    background: #090c0a;\n    border: 1px solid #2a2e2c;\n  }\n\n  .fw-bar-eq span {\n    width: 3px;\n    height: 4px;\n    background: #a050f0;\n    transition: height 0.1s ease;\n  }\n\n  .fw-bar-eq.playing span:nth-child(1) { animation: fwEq 0.8s infinite ease-in-out; }\n  .fw-bar-eq.playing span:nth-child(2) { animation: fwEq 0.5s infinite ease-in-out 0.1s; }\n  .fw-bar-eq.playing span:nth-child(3) { animation: fwEq 0.9s infinite ease-in-out 0.2s; }\n  .fw-bar-eq.playing span:nth-child(4) { animation: fwEq 0.6s infinite ease-in-out 0.15s; }\n  .fw-bar-eq.playing span:nth-child(5) { animation: fwEq 0.7s infinite ease-in-out 0.05s; }\n  .fw-bar-eq.playing span:nth-child(6) { animation: fwEq 1.1s infinite ease-in-out 0.25s; }\n  .fw-bar-eq.playing span:nth-child(7) { animation: fwEq 0.4s infinite ease-in-out 0.3s; }\n  .fw-bar-eq.playing span:nth-child(8) { animation: fwEq 0.85s infinite ease-in-out 0.1s; }\n\n  @keyframes fwEq {\n    0%, 100% { height: 4px; }\n    50% { height: 18px; }\n  }\n\n  /* Laufen die Balken auf echtem Ton, muss die CSS-Animation schweigen --\n     sonst zerren beide gleichzeitig an der Hoehe und es ruckelt. */\n  .fw-bar-eq.live span {\n    animation: none !important;\n    transition: height 70ms linear;\n  }\n  /* Der Punkt am Cover pulsiert mit dem Bass. */\n  .fw-bar-pulse {\n    transform: scale(calc(1 + var(--ff-bass, 0) * 0.9));\n    transition: transform 90ms linear;\n  }\n\n  .fw-player-right {\n    display: flex;\n    align-items: center;\n    gap: 16px;\n  }\n\n  @media (max-width: 768px) {\n    .fw-player-right { display: none; }\n    .fw-player-left { min-width: auto; max-width: 180px; }\n  }\n\n  .fw-bar-badge {\n    font-size: 0.7rem;\n    font-weight: 700;\n    color: #2ecc71;\n    background: #004030;\n    border: 1px solid #006048;\n    padding: 4px 8px;\n    letter-spacing: 0.08em;\n  }\n\n  .fw-bar-vol-box {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n  }\n\n  .fw-bar-slider {\n    width: 80px;\n    accent-color: #a050f0;\n    cursor: pointer;\n  }\n\n  .fw-bar-open-btn {\n    background: transparent;\n    color: #ffffff;\n    border: 1px solid #2a2e2c;\n    padding: 6px 12px;\n    font-size: 0.75rem;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 0.06em;\n    text-decoration: none;\n    transition: all 0.2s ease;\n  }\n\n  .fw-bar-open-btn:hover {\n    background: #a050f0;\n    border-color: #a050f0;\n  }\n</style>\n\n<script type=\"text/javascript\">\n(function() {\n  if (window.fwAudio) return; // already initialized\n\n  var streamUrl = 'https://funk.frawo.tech/listen/frawo_funk/radio.mp3';\n  var azuraApi = 'https://funk.frawo.tech/api/nowplaying/frawo_funk';\n  var audio = new Audio();\n  audio.preload = 'none';\n  /* Fuer die Tonanalyse (Beat-Visual auf /radio) muss der Stream per CORS\n     gelesen werden. funk.frawo.tech sendet dafuer\n     access-control-allow-origin: https://frawo.tech (geprueft 07.10.2026).\n     Ohne diese Zeile liefert die Analyse nur Nullen. */\n  audio.crossOrigin = 'anonymous';\n\n  /* ---- Tonanalyse: liefert Pegel fuer das Beat-Visual ----\n     Alles in try/catch: wenn der Browser kein Web Audio kann oder CORS\n     scheitert, laeuft die Wiedergabe normal weiter und das Visual bleibt\n     einfach ruhig. Der Ton darf NIE am Visual scheitern. */\n  var audioCtx = null;\n  var analyser = null;\n  var freqData = null;\n  var analyseAktiv = false;\n\n  /* WICHTIG: Diese Funktion MUSS direkt im Klick laufen, nicht erst im\n     .then() von play(). Im Promise-Callback gilt die Nutzergeste nicht mehr,\n     der Audio-Kontext bleibt dann auf 'suspended' -- die Analyse liefert nur\n     Nullen UND der Ton wird stumm, weil das Audio-Element dann durch einen\n     schlafenden Kontext geleitet wird. */\n  function analyseStarten() {\n    if (analyseAktiv) return;\n    try {\n      var Ctx = window.AudioContext || window.webkitAudioContext;\n      if (!Ctx) return;\n      if (!audioCtx) audioCtx = new Ctx();\n      if (audioCtx.state === 'suspended' && audioCtx.resume) {\n        audioCtx.resume();\n      }\n      /* Erst verdrahten, wenn der Kontext wirklich laeuft. Sonst lieber keine\n         Analyse als ein stummer Stream. */\n      if (audioCtx.state !== 'running') {\n        return;\n      }\n      if (!analyser) {\n        analyser = audioCtx.createAnalyser();\n        analyser.fftSize = 512;\n        analyser.smoothingTimeConstant = 0.75;\n        freqData = new Uint8Array(analyser.frequencyBinCount);\n        var quelle = audioCtx.createMediaElementSource(audio);\n        quelle.connect(analyser);\n        analyser.connect(audioCtx.destination);\n      }\n      analyseAktiv = true;\n      console.log('FraWo Funk: Tonanalyse aktiv');\n    } catch (e) {\n      console.log('Tonanalyse nicht verfuegbar, Wiedergabe laeuft weiter:', e);\n      analyser = null;\n      analyseAktiv = false;\n    }\n  }\n\n  var state = {\n    isPlaying: false,\n    title: 'FraWo Funk Live',\n    artist: '320kbps HD Stream',\n    art: '/logo.png?company=1',\n    volume: 0.8\n  };\n\n  audio.volume = state.volume;\n\n  audio.addEventListener('play', function() {\n    state.isPlaying = true;\n    try { localStorage.setItem('fwRadioWasPlaying', '1'); } catch (e) {}\n    updateUI();\n  });\n\n  audio.addEventListener('pause', function() {\n    state.isPlaying = false;\n    try { localStorage.setItem('fwRadioWasPlaying', '0'); } catch (e) {}\n    updateUI();\n  });\n\n  audio.addEventListener('error', function(e) {\n    console.log('Stream reconnecting...', e);\n    state.isPlaying = false;\n    updateUI();\n  });\n\n  function updateUI() {\n    var bar = document.getElementById('fwPersistentPlayerBar');\n    if (bar) {\n      if (state.isPlaying || audio.src) {\n        bar.style.display = 'block';\n      }\n    }\n\n    var playBtns = document.querySelectorAll('#fwBarPlayBtn, #fwRadioPlayBtn, #fwHeroRadioPlayBtn, #ff-play-btn');\n    playBtns.forEach(function(b) {\n      if (b.id === 'ff-play-btn') {\n        var ico = document.getElementById('ff-play-ico');\n        var txt = document.getElementById('ff-play-txt');\n        if (ico) ico.textContent = state.isPlaying ? '❚❚' : '▶';\n        if (txt) txt.textContent = state.isPlaying ? 'PAUSE' : 'LISTEN LIVE';\n      } else {\n        b.textContent = state.isPlaying ? '❚❚' : '▶';\n      }\n    });\n\n    var eqBoxes = document.querySelectorAll('#fwBarEq, #fwEqBars, #ff-vis-box');\n    eqBoxes.forEach(function(eq) {\n      if (state.isPlaying) {\n        eq.classList.add('playing');\n      } else {\n        eq.classList.remove('playing');\n      }\n    });\n\n    // Update Meta\n    var tEls = document.querySelectorAll('#fwBarTitle, #fwHeroRadioTitle, #ff-title');\n    tEls.forEach(function(el) { el.textContent = state.title; });\n\n    var aEls = document.querySelectorAll('#fwBarArtist, #fwHeroRadioArtist, #ff-artist');\n    aEls.forEach(function(el) { el.textContent = state.artist; });\n\n    var cEls = document.querySelectorAll('#fwBarCover, #fwHeroRadioCover, #ff-deck-art');\n    cEls.forEach(function(el) { if (state.art) el.src = state.art; });\n  }\n\n  function fetchNowPlaying() {\n    fetch(azuraApi)\n      .then(function(r) { return r.json(); })\n      .then(function(d) {\n        if (d && d.now_playing && d.now_playing.song) {\n          var s = d.now_playing.song;\n          state.title = s.title || 'FraWo Funk Live';\n          state.artist = s.artist || 'Club & Studio Sound';\n          if (s.art) state.art = s.art;\n          updateUI();\n        }\n      })\n      .catch(function() {});\n  }\n\n  function startPlayback() {\n    /* Zuerst die Analyse: hier sind wir noch in der Nutzergeste. */\n    analyseStarten();\n    audio.src = streamUrl;\n    audio.load();\n    audio.play().then(function() {\n      state.isPlaying = true;\n      /* Zweiter Versuch, falls der Kontext beim Klick noch nicht lief\n         (manche Browser erlauben resume erst nach dem ersten Abspielen). */\n      analyseStarten();\n      updateUI();\n    }).catch(function(e) {\n      console.log('Play err:', e);\n    });\n  }\n\n  window.fwAudio = {\n    togglePlay: function() {\n      if (state.isPlaying) {\n        audio.pause();\n        audio.src = '';\n      } else {\n        startPlayback();\n      }\n    },\n    setVolume: function(v) {\n      state.volume = parseFloat(v);\n      audio.volume = state.volume;\n    },\n    getState: function() {\n      return state;\n    },\n\n    /* Rohdaten des Frequenzspektrums (0..255 je Band) oder null. */\n    getFrequencyData: function() {\n      if (!analyser || !freqData) return null;\n      try {\n        analyser.getByteFrequencyData(freqData);\n        return freqData;\n      } catch (e) {\n        return null;\n      }\n    },\n\n    /* Fertig aufbereitete Pegel 0..1 fuer das Visual.\n       bass = Wumms (Kick/Bassline), mitte = Koerper, hoehen = Hi-Hats.\n       Ohne Analyse kommen Nullen zurueck -- die Seite bleibt dann ruhig. */\n    getLevels: function() {\n      var daten = window.fwAudio.getFrequencyData();\n      if (!daten || !state.isPlaying) {\n        return { bass: 0, mitte: 0, hoehen: 0, gesamt: 0 };\n      }\n      function mittel(von, bis) {\n        var summe = 0;\n        var anzahl = 0;\n        for (var i = von; i < bis && i < daten.length; i++) {\n          summe += daten[i];\n          anzahl++;\n        }\n        return anzahl ? (summe / anzahl) / 255 : 0;\n      }\n      var bass = mittel(1, 8);\n      var mitte = mittel(8, 40);\n      var hoehen = mittel(40, 110);\n      return {\n        bass: bass,\n        mitte: mitte,\n        hoehen: hoehen,\n        gesamt: (bass * 0.6 + mitte * 0.3 + hoehen * 0.1)\n      };\n    }\n  };\n\n  // Aliases for compatibility with /radio\n  window.ffTogglePlay = window.fwAudio.togglePlay;\n  window.toggleRadioPlay = window.fwAudio.togglePlay;\n\n  fetchNowPlaying();\n  setInterval(fetchNowPlaying, 8000);\n\n  /* ===== Leiste unten: Balken laufen auf echtem Ton =====\n     Vorher liefen die acht Balken nur auf einer CSS-Animation mit festen\n     Zeiten -- das sah gleichmaessig aus und hatte mit der Musik nichts zu tun.\n     Jetzt holen sie sich dieselben Pegel wie das Visual auf /radio.\n     Ohne Tonanalyse bleibt die CSS-Animation als Rueckfall aktiv. */\n  var barBalken = null;\n  var barLaufAktiv = false;\n\n  function barBalkenHolen() {\n    if (!barBalken || !barBalken.length) {\n      var eq = document.getElementById('fwBarEq');\n      barBalken = eq ? eq.querySelectorAll('span') : null;\n    }\n    return barBalken;\n  }\n\n  function barFrame() {\n    var balken = barBalkenHolen();\n    var eq = document.getElementById('fwBarEq');\n\n    /* Pegel auch fuer die CSS-Variablen setzen, damit die Leiste auf JEDER\n       Seite mitatmet -- nicht nur auf /radio. Die Radioseite ueberschreibt\n       dieselben Variablen mit ihrer eigenen Glaettung. */\n    var pegel = window.fwAudio.getLevels();\n    document.documentElement.style.setProperty('--ff-bass', pegel.bass.toFixed(3));\n\n    if (balken && balken.length && state.isPlaying) {\n      var daten = window.fwAudio.getFrequencyData();\n      if (daten) {\n        /* Echte Daten: CSS-Animation abschalten, sonst zerren beide an der Hoehe. */\n        if (eq) eq.classList.add('live');\n        var nutzbar = Math.floor(daten.length * 0.6);\n        for (var i = 0; i < balken.length; i++) {\n          var von = Math.floor(i * nutzbar / balken.length);\n          var bis = Math.max(von + 1, Math.floor((i + 1) * nutzbar / balken.length));\n          var summe = 0;\n          for (var j = von; j < bis; j++) summe += daten[j];\n          var wert = (summe / (bis - von)) / 255;\n          balken[i].style.height = Math.max(3, Math.min(18, 3 + wert * 17)) + 'px';\n        }\n      } else if (eq) {\n        /* Keine Analyse: zurueck auf die CSS-Animation. */\n        eq.classList.remove('live');\n        for (var k = 0; k < balken.length; k++) {\n          balken[k].style.height = '';\n        }\n      }\n    } else if (balken && balken.length) {\n      if (eq) eq.classList.remove('live');\n      for (var m = 0; m < balken.length; m++) {\n        balken[m].style.height = '';\n      }\n    }\n\n    requestAnimationFrame(barFrame);\n  }\n\n  if (!barLaufAktiv) {\n    barLaufAktiv = true;\n    requestAnimationFrame(barFrame);\n  }\n\n  /* ===== Weiterspielen beim Navigieren =====\n     Odoo ist eine klassische Mehrseiten-Website (kein SPA). Echtes,\n     lueckenloses Weiterspielen ueber einen vollen Seitenwechsel hinweg\n     ist technisch nicht moeglich, ohne die Navigation selbst zu kapern -\n     das hatte hier vorher gesteckt und dabei jeden internen Link lahmgelegt\n     (der Fetch-basierte Router ist nie fertig gelaufen). Stattdessen: der\n     Wiedergabe-Status wird gemerkt und auf der naechsten Seite in Sekunden-\n     bruchteilen automatisch fortgesetzt - der Standardansatz, den auch\n     grosse Radiosender-Seiten nutzen. */\n  var wasPlaying = false;\n  try { wasPlaying = localStorage.getItem('fwRadioWasPlaying') === '1'; } catch (e) {}\n  if (wasPlaying) {\n    startPlayback();\n  }\n})();\n</script>\n"
}
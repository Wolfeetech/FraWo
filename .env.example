# ==============================================================================
# FraWo GbR — Environment Configuration Template (.env.example)
# Copy to .env and adjust values for local development or production execution
# ==============================================================================

# --- Odoo ERP System ---
ODOO_URL=http://10.1.0.112:8069
ODOO_DB=FraWo_GbR
ODOO_USER=wolf@frawo.tech
ODOO_PASSWORD=your_odoo_password_here

# --- OpenClaw KI Gateway ---
OPENCLAW_HOST=10.1.0.31
OPENCLAW_PORT=19000
OPENCLAW_WEB_SERVER_PORT=5555
OPENCLAW_TOKEN=your_openclaw_token_here

# --- AzuraCast Radio Server ---
AZURACAST_URL=http://10.1.0.38
AZURACAST_STREAM_URL=http://10.1.0.38:8000/radio.mp3
AZURACAST_STATION_ID=frawo-funk

# --- Local LLM & Ollama ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=frawo-pro:latest

# --- Communications & Notifications ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# YourParty.tech Production Environment (Template)
# IMPORTANT: no plaintext secrets in git
# Copy to local runtime file and inject real values via secret manager.

# MongoDB - Full URI (used by startup_event)
MONGO_URI=mongodb://<user>:<password>@<host>:27017/<database>?authSource=admin

# MongoDB - Individual params (legacy)
MONGO_HOST=<mongo-host>
MONGO_PORT=27017
MONGO_USER=<mongo-user>
MONGO_PASSWORD=<mongo-password>
MONGO_DB=<mongo-database>

# AzuraCast
AZURACAST_URL=https://<azuracast-host>
AZURACAST_API_KEY=<azuracast-api-key>
AZURACAST_STATION_ID=1
AZURACAST_VERIFY_SSL=true

# Feature Flags
FEATURE_MOOD_VOTES=true
FEATURE_MOOD_SYNC=false
FEATURE_MOOD_AUTODJ=false

# Application
APP_NAME=FraWo Radio Backend
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=false

# Database
DATABASE_URL=postgresql+asyncpg://radio:radio@localhost:5432/frawo_radio
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://funk.frawo-tech.de
CORS_ALLOW_CREDENTIALS=true

# AzuraCast Integration
AZURACAST_API_URL=https://radio-anker.hs27.internal/api
AZURACAST_API_KEY=your-azuracast-api-key
AZURACAST_STATION_ID=1
AZURACAST_VERIFY_SSL=true

# Odoo ERP Integration (SSOT für Partner, Leads & Supporter-Status)
# WICHTIG: ODOO_PASSWORD MUSS gesetzt sein — nie in Git commiten!
ODOO_URL=http://10.4.0.22:8069
ODOO_DB=FraWo_GbR
ODOO_USER=wolf@frawo-tech.de
ODOO_PASSWORD=change-me-in-production-env

# Admin API (schützt /set_supporter — nie in Git commiten!)
ADMIN_API_KEY=change-me-in-production-env


# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# WebSocket
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=1000
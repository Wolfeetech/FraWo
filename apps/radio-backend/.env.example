# Application
APP_NAME=FraWo Radio Backend
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=false

# Database
DATABASE_URL=postgresql+asyncpg://radio:radio@localhost:5432/frawo_radio
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","https://frawo-funk.com"]
CORS_ALLOW_CREDENTIALS=true

# AzuraCast Integration
AZURACAST_API_URL=https://radio-anker.hs27.internal/api
AZURACAST_API_KEY=your-azuracast-api-key
AZURACAST_STATION_ID=1
AZURACAST_VERIFY_SSL=true

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# WebSocket
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=1000
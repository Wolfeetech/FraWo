<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <!-- Server Action: HTTP POST to ServAssi Webhook -->
    <record id="action_servassi_webhook" model="ir.actions.server">
      <field name="name">ServAssi: Webhook POST</field>
      <field name="model_id" ref="project.model_project_task"/>
      <field name="state">code</field>
      <field name="code">records._trigger_servassi_webhook()</field>
    </record>

    <!-- Automation: DevOps-Agent Task → Backlog → Trigger ServAssi -->
    <record id="automation_servassi_devops_trigger" model="base.automation">
      <field name="name">ServAssi: DevOps-Task Backlog-Eingang → Webhook</field>
      <field name="model_id" ref="project.model_project_task"/>
      <field name="trigger">on_write</field>
      <field name="filter_domain">[["tag_ids","in",[75]],["stage_id","=",1]]</field>
      <field name="filter_pre_domain">[["stage_id","!=",1]]</field>
      <field name="active" eval="True"/>
      <field name="action_server_ids" eval="[(4, ref('frawo_agent.action_servassi_webhook'))]"/>
    </record>

  </data>
</odoo>

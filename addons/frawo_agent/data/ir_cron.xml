<odoo>
  <data noupdate="1">
    <record id="cron_agent_queue" model="ir.cron">
      <field name="name">FraWo Agent: Task-Queue abarbeiten</field>
      <field name="model_id" ref="project.model_project_task"/>
      <field name="state">code</field>
      <field name="code">model._cron_process_agent_queue()</field>
      <field name="interval_number">2</field>
      <field name="interval_type">minutes</field>
      <field name="active" eval="True"/>
      <field name="user_id" ref="base.user_root"/>
    </record>

    <record id="cron_sync_azuracast_users" model="ir.cron">
      <field name="name">FraWo Agent: Sync portal users with AzuraCast</field>
      <field name="model_id" ref="base.model_res_users"/>
      <field name="state">code</field>
      <field name="code">model._cron_sync_azuracast_users()</field>
      <field name="interval_number">10</field>
      <field name="interval_type">minutes</field>
      <field name="active" eval="True"/>
      <field name="user_id" ref="base.user_root"/>
    </record>

    <record id="cron_anker_tracker_backup" model="ir.cron">
      <field name="name">Anker Tracker: Täglicher neutraler Backup-Export</field>
      <field name="model_id" ref="model_anker_tracker_consumption"/>
      <field name="state">code</field>
      <field name="code">model.cron_backup_consumption_neutral()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="active" eval="True"/>
      <field name="user_id" ref="base.user_root"/>
    </record>

    <record id="cron_anker_telegram_summary" model="ir.cron">
      <field name="name">Anker Tracker: Stündliche Telegram-Zusammenfassung</field>
      <field name="model_id" ref="model_anker_tracker_consumption"/>
      <field name="state">code</field>
      <field name="code">model.cron_telegram_hourly_summary()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">hours</field>
      <field name="active" eval="True"/>
      <field name="user_id" ref="base.user_root"/>
    </record>
  </data>
</odoo>

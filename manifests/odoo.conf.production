; ==============================================================================
; FraWo GbR — Odoo 19 Production Server Configuration (CT140)
; Canonical Location: /etc/odoo/odoo.conf
; Applied: 25.07.2026
; ==============================================================================

[options]
addons_path = /usr/lib/python3/dist-packages/odoo/addons,/opt/frawotech/extra-addons
data_dir = /var/lib/odoo
db_host = False
db_port = False
db_user = odoo
db_password = False

; --- Security Hardening ---
list_db = False
admin_passwd = $pbkdf2-sha512$60000$FraWoMasterKey2026!

; --- Multi-Processing & Performance Tuning (CT140: 4 GB RAM, 2 VCPUs) ---
workers = 2
max_cron_threads = 1

; --- Memory & Timeout Safety Limits ---
limit_memory_soft = 2147483648
limit_memory_hard = 2684354560
limit_time_cpu = 600
limit_time_real = 1200
limit_request = 8192

; --- Networking & Logging ---
http_interface = 0.0.0.0
http_port = 8069
longpolling_port = 8072
proxy_mode = True
logfile = /var/log/odoo/odoo-server.log
log_level = info
